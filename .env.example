# ============================================================
# Intel Briefing — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your API keys.
# All variables are optional; sensors gracefully skip when absent.
# ============================================================

# --- API Keys ---

# GitHub — used by the GitHub sensor (GraphQL API)
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# Product Hunt — used by the ProductHunt sensor (official GraphQL API)
PRODUCTHUNT_TOKEN=your_producthunt_developer_token_here

# --- Database (libSQL / Turso) ---

# Local dev / Docker: SQLite file (auto-created on first run).
# Vercel / production: use a Turso libsql:// URL.
DATABASE_URL=file:data/intel.db

# --- Service Config ---

# Fetch schedule: HH:MM in FETCH_TIMEZONE (default: 07:30 Asia/Shanghai)
FETCH_TIME=07:30
FETCH_TIMEZONE=Asia/Shanghai

# Cache TTL in hours before a report is considered stale (default: 6)
CACHE_TTL_HOURS=6

# Default items per section (default: 10, max 50)
DEFAULT_LIMIT=10
