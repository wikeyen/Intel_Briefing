#!/usr/bin/env python3
"""
Register a Docker Compose web app behind the host Tailscale URL using a path prefix.

This script writes a compose override file under gateway/apps/<name>.override.yml.
Apply it by starting/recreating the target app service with both compose files, e.g.:

  docker compose -f docker-compose.yml -f gateway/apps/myapp.override.yml up -d myservice

The gateway (`docker-compose.gateway.yml`) must already be running, and the app service
must share a Docker network reachable by Traefik.
"""
from __future__ import annotations

import argparse
from pathlib import Path
import re
import sys

ROOT = Path(__file__).resolve().parents[1]
OUT_DIR = ROOT / 'gateway' / 'apps'

TOP_LEVEL_ROUTES = [
    'dashboard', 'data', 'ai', 'briefing', 'connections', 'console',
    'pipeline', 'sources', 'status', 'settings'
]


def slugify(value: str) -> str:
    value = value.strip().lower()
    value = re.sub(r'[^a-z0-9]+', '-', value)
    value = re.sub(r'-+', '-', value).strip('-')
    if not value:
        raise SystemExit('app name/path slug became empty')
    return value


def build_override(service: str, slug: str, port: int, top_routes: list[str]) -> str:
    route_alt = '|'.join([re.escape(x) for x in top_routes])
    redirect_regex = rf'^/({route_alt}|api(?:/.*)?)$'
    return f'''# Generated by scripts/register-tailnet-path-app
# App URL: /{slug}
services:
  {service}:
    labels:
      - traefik.enable=true
      - traefik.http.routers.{slug}.rule=PathPrefix(`/{slug}`) || HeaderRegexp(`Referer`, `.*/{slug}(?:/.*)?$`)
      - traefik.http.routers.{slug}.entrypoints=web
      - traefik.http.middlewares.{slug}-strip.stripprefix.prefixes=/{slug}
      - traefik.http.middlewares.{slug}-prefix.redirectregex.regex={redirect_regex}
      - traefik.http.middlewares.{slug}-prefix.redirectregex.replacement=/{slug}/$$1
      - traefik.http.middlewares.{slug}-prefix.redirectregex.permanent=false
      - traefik.http.routers.{slug}.middlewares={slug}-prefix,{slug}-strip
      - traefik.http.services.{slug}.loadbalancer.server.port={port}
'''


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument('--service', required=True, help='docker compose service name to label')
    ap.add_argument('--name', required=True, help='public path slug, e.g. intel-briefing')
    ap.add_argument('--port', required=True, type=int, help='internal container port, e.g. 3000')
    ap.add_argument('--top-route', action='append', default=[], help='extra absolute app route to rewrite under the prefix; repeatable')
    ap.add_argument('--output', help='override file path; default gateway/apps/<name>.override.yml')
    args = ap.parse_args()

    slug = slugify(args.name)
    top_routes = TOP_LEVEL_ROUTES + args.top_route
    out = Path(args.output) if args.output else (OUT_DIR / f'{slug}.override.yml')
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(build_override(args.service, slug, args.port, top_routes))

    print(f'Wrote {out.relative_to(ROOT)}')
    print('\nNext steps:')
    print(f'  docker compose -f docker-compose.yml -f {out.relative_to(ROOT)} up -d {args.service}')
    print(f'  open https://lemnis-mac-mini.tail3cc92f.ts.net/{slug}')
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
