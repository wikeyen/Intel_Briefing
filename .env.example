# ============================================================
# Intel Briefing — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your API keys.
# All variables are optional; sensors gracefully skip when absent.
# ============================================================

# --- API Keys ---

# Google Gemini — used for Chinese translation of titles and abstracts
GEMINI_API_KEY=your_gemini_api_key_here

# xAI (Grok) — used for Grok, Politics, and Topics sensors
XAI_API_KEY=your_xai_api_key_here

# Official xAI endpoint. Change only if you need a relay for geo-restricted access.
# WARNING: A relay routes your API key through a third party. Only use a trusted operator.
XAI_BASE_URL=https://api.x.ai/v1/chat/completions

# xAI model name (grok-3 recommended)
XAI_MODEL=grok-3

# GitHub — used by the GitHub sensor (GraphQL API)
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# Product Hunt — used by the ProductHunt sensor (official GraphQL API)
PRODUCTHUNT_TOKEN=your_producthunt_developer_token_here

# --- Service Config ---

# Fetch schedule: HH:MM in FETCH_TIMEZONE (default: 07:30 Asia/Shanghai)
FETCH_TIME=07:30
FETCH_TIMEZONE=Asia/Shanghai

# Cache TTL in hours before a report is considered stale (default: 6)
CACHE_TTL_HOURS=6

# Default output language: "en" or "zh"
DEFAULT_LANGUAGE=en

# Default items per section (default: 10, max 50)
DEFAULT_LIMIT=10
